# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в git не попадает — он в .gitignore.
#
# Пока эти переменные не заданы, сайт собирается из локальных данных
# (src/data/projects.ts) и полностью работоспособен.

# Идентификатор проекта Sanity. Показывается при создании проекта
# и лежит в studio/sanity.config.ts после `npm create sanity@latest`.
SANITY_PROJECT_ID=

# Имя датасета. По умолчанию Sanity создаёт "production".
SANITY_DATASET=production

# ВАЖНО: токен с правами на запись сюда не кладут и никуда не публикуют.
# Сайт только читает публичный датасет и токен для этого не использует.
