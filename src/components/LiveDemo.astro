---
import { pick, type EnabledLocale } from '../i18n/config';
import { t } from '../i18n/ui';
import type { ProjectDemo, ProjectImage } from '../data/types';

interface Props {
  demo: ProjectDemo;
  lang: EnabledLocale;
  title: string;
  /** Обложка проекта — заставка до запуска. */
  poster?: ProjectImage;
}

const { demo, lang, title, poster } = Astro.props;
const strings = t(lang);
const note = demo.note ? pick(demo.note, lang) : undefined;

// Рамка грузится только по клику, как и плеер видео: иначе каждая страница
// проекта тянула бы целый второй сайт вместе со шрифтами и скриптами —
// и делала бы это ради посетителя, который, может быть, просто листает.
---

<div
  class="demo"
  data-demo
  data-src={demo.src}
  data-title={title}
  style={[
    demo.ratio && `--demo-ratio: ${demo.ratio}`,
    demo.maxWidth && `--demo-max: ${demo.maxWidth}`,
  ]
    .filter(Boolean)
    .join('; ') || undefined}
>
  <!-- Оконная рамка: сразу видно, что внутри настоящая страница,
       а не картинка. Адрес показан ради того же. -->
  <div class="demo__chrome">
    <span class="demo__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="demo__url">{demo.src}</span>

    <div class="demo__tools">
      <button type="button" class="demo__tool" data-demo-reload hidden>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-2.6-6.4"></path>
          <path d="M21 3v6h-6"></path>
        </svg>
        <span>{strings.project.demoReload}</span>
      </button>

      <a class="demo__tool" href={demo.src} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 4h6v6"></path>
          <path d="M20 4 11 13"></path>
          <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
        </svg>
        <span>{strings.project.demoOpen}</span>
      </a>
    </div>
  </div>

  <div class="demo__stage">
    <button type="button" class="demo__start" data-demo-start>
      {
        poster ? (
          <img
            class="demo__poster"
            src={poster.src}
            alt=""
            width={poster.width ?? 1600}
            height={poster.height ?? 1000}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="demo__poster demo__poster--blank" aria-hidden="true" />
        )
      }

      <span class="demo__cta">
        <span class="demo__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
            <path d="M8 5.5v13l11-6.5z"></path>
          </svg>
        </span>
        <span class="demo__cta-text">
          <b>{strings.project.demoPlay}</b>
          <em>{strings.project.demoHint}</em>
        </span>
      </span>
      <span class="visually-hidden">{`${strings.project.demoPlay} — ${title}`}</span>
    </button>
  </div>

  {note && <p class="demo__note">{note}</p>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((wrapper) => {
    const start = wrapper.querySelector<HTMLButtonElement>('[data-demo-start]');
    const reload = wrapper.querySelector<HTMLButtonElement>('[data-demo-reload]');
    const stage = wrapper.querySelector<HTMLElement>('.demo__stage');
    if (!start || !stage) return;

    let frame: HTMLIFrameElement | null = null;

    const launch = () => {
      const src = wrapper.dataset.src;
      if (!src) return;

      frame = document.createElement('iframe');
      frame.src = src;
      frame.title = wrapper.dataset.title ?? '';
      frame.className = 'demo__frame';
      frame.loading = 'lazy';
      frame.allow = 'fullscreen; autoplay';
      // Копия лежит на том же домене, но своя песочница ей не мешает:
      // ни всплывающих окон вслепую, ни попыток увести верхнюю страницу.
      frame.setAttribute(
        'sandbox',
        'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox',
      );

      // Заставка не убирается сразу: пока внутри грузятся шрифты и скрипты,
      // рамка белая, и подмена выглядит как будто проект сломался. Ждём
      // load и только тогда снимаем картинку из-под рамки.
      frame.addEventListener(
        'load',
        () => {
          start.remove();
          if (reload) reload.hidden = false;
        },
        { once: true },
      );

      stage.append(frame);
      start.classList.add('is-loading');
      start.disabled = true;
    };

    start.addEventListener('click', launch);

    reload?.addEventListener('click', () => {
      // Пересоздаём элемент, а не трогаем frame.src: у копии на том же
      // домене перезапись src добавляет запись в историю вкладки, и кнопка
      // «назад» начинает листать состояния игры вместо возврата на сайт.
      if (!frame) return;
      const fresh = frame.cloneNode() as HTMLIFrameElement;
      stage.replaceChildren(fresh);
      frame = fresh;
    });
  });
</script>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* Портретные работы (телефонная игра) сужаются и встают по центру */
    max-width: var(--demo-max, none);
    margin-inline: auto;
    width: 100%;
  }

  .demo__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--bg-elev-2);
  }

  .demo__dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .demo__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .demo__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }

  .demo__tools {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
  }

  .demo__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink-dim);
    font-size: 0.76rem;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .demo__tool:hover {
    color: var(--gold);
    border-color: var(--line);
  }

  .demo__stage {
    position: relative;
    aspect-ratio: var(--demo-ratio, 16 / 10);
    /* Рамка не должна становиться щёлочкой на телефоне: там пропорции
       дают меньше двухсот пикселей высоты, и внутри ничего не разобрать. */
    min-height: min(70svh, 460px);
    border: 1px solid var(--line);
    border-radius: 0 0 var(--radius) var(--radius);
    overflow: hidden;
    background: var(--bg-elev-2);
  }

  .demo__start {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .demo__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s var(--ease), opacity 0.25s var(--ease);
  }

  .demo__poster--blank {
    display: block;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--gold) 22%, var(--bg-elev-2)),
      color-mix(in srgb, var(--purple) 22%, var(--bg-elev-2))
    );
  }

  .demo__start:hover .demo__poster {
    transform: scale(1.02);
    opacity: 0.8;
  }

  .demo__cta {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 2.5rem 1.1rem 1.1rem;
    text-align: left;
    background: linear-gradient(to top, color-mix(in srgb, var(--bg) 92%, transparent), transparent);
  }

  .demo__play {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--on-gold);
    box-shadow: var(--shadow-md);
    transition: transform 0.22s var(--ease);
  }

  .demo__start:hover .demo__play {
    transform: scale(1.08);
  }

  .demo__cta-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .demo__cta-text b {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .demo__cta-text em {
    font-style: normal;
    font-size: 0.82rem;
    color: var(--ink-dim);
  }

  /* Рамка ложится поверх заставки, а не вместо неё */
  .demo :global(.demo__frame) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  .demo__start.is-loading {
    cursor: progress;
  }

  .demo__start.is-loading .demo__play {
    animation: demo-pulse 1s ease-in-out infinite;
  }

  @keyframes demo-pulse {
    50% {
      transform: scale(0.86);
      opacity: 0.65;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo__start.is-loading .demo__play {
      animation: none;
    }
  }

  .demo__note {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-dim);
  }

  @media (max-width: 560px) {
    /* В узкой шапке подписи кнопок съедают адрес — оставляем значки */
    .demo__tool span:not(.visually-hidden) {
      display: none;
    }

    .demo__cta {
      padding: 2rem 0.8rem 0.8rem;
      gap: 0.6rem;
    }

    .demo__play {
      width: 44px;
      height: 44px;
    }
  }
</style>
