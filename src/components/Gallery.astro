---
import { pick, type EnabledLocale } from '../i18n/config';
import type { ProjectImage } from '../data/types';

interface Props {
  images: ProjectImage[];
  lang: EnabledLocale;
}

const { images, lang } = Astro.props;
---

<ul class="gallery">
  {
    images.map((image, index) => (
      <li class="gallery__item">
        <figure class="gallery__figure">
          {/* Первая картинка почти всегда в зоне видимости — её грузим сразу */}
          <img
            src={image.src}
            alt={pick(image.alt, lang)}
            width={image.width ?? 1200}
            height={image.height ?? 750}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {image.caption && <figcaption>{pick(image.caption, lang)}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gallery__figure {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
  }

  /* Одна картинка на всю ширину контейнера выглядит плакатом: квадратный
     рендер 1080×1080 растягивался бы на 1180px и занимал экран целиком.
     :has() не поддержан — просто останется прежняя полная ширина. */
  .gallery:has(> :only-child) {
    max-width: 780px;
    margin-inline: auto;
  }

  .gallery__figure img {
    width: 100%;
    height: auto;
    /* Соотношение сторон у скриншотов разное — не режем, а вписываем */
    object-fit: contain;
    /* Потолок по высоте: вертикальные скриншоты телефона иначе
       выталкивают всё остальное далеко за пределы экрана */
    max-height: 78vh;
    background: var(--bg-elev-2);
  }

  .gallery__figure figcaption {
    padding: 0.7rem var(--space-2);
    font-size: 0.85rem;
    color: var(--ink-dim);
    border-top: 1px solid var(--line);
  }
</style>
