---
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { SECTIONS_BY_ORDER } from '../data/sections';
import { CONTACTS, PROFILE } from '../data/site';
import { localePath, pick, type EnabledLocale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  lang: EnabledLocale;
}

const { lang } = Astro.props;
const strings = t(lang);

const year = new Date().getFullYear();
const copyrightYears = year > PROFILE.since ? `${PROFILE.since}—${year}` : `${year}`;

const iconFor: Record<string, IconName> = {
  telegram: 'telegram',
  github: 'github',
  instagram: 'instagram',
  linkedin: 'linkedin',
  fiverr: 'fiverr',
};
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <span class="site-footer__name">{strings.home.name}</span>
        <p class="site-footer__tagline">{strings.home.tagline}</p>
        <ul class="site-footer__social">
          {
            CONTACTS.map((contact) => (
              <li>
                <a
                  href={contact.url}
                  class="site-footer__social-link"
                  target="_blank"
                  rel="noopener noreferrer me"
                  aria-label={contact.label}
                  title={`${contact.label} — ${contact.handle}`}
                >
                  <Icon name={iconFor[contact.id] ?? 'external'} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="site-footer__col" aria-label={strings.nav.work}>
        <h2 class="site-footer__heading">{strings.nav.work}</h2>
        <ul>
          {
            SECTIONS_BY_ORDER.map((section) => (
              <li>
                <a href={localePath(lang, `work/${section.slug}`)}>{pick(section.title, lang)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label={strings.footer.nav}>
        <h2 class="site-footer__heading">{strings.footer.nav}</h2>
        <ul>
          <li><a href={localePath(lang)}>{strings.meta.siteName}</a></li>
          <li><a href={localePath(lang, 'about')}>{strings.nav.about}</a></li>
          <li><a href={localePath(lang, 'contacts')}>{strings.nav.contacts}</a></li>
          <li><a href={localePath(lang, 'privacy')}>{strings.footer.privacy}</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <small>© {copyrightYears} {strings.home.name}. {strings.footer.rights}</small>
      <a class="site-footer__top" href="#main">
        {strings.footer.toTop}
        <Icon name="arrow-up" size={15} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    padding-block: var(--space-4) var(--space-3);
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    color: var(--ink-dim);
    font-size: 0.9rem;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: var(--space-4);
    }
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--ink);
  }

  .site-footer__tagline {
    margin: 0.35rem 0 var(--space-2);
    max-width: 34ch;
    color: var(--ink-faint);
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__social-link {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink-dim);
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease),
      transform 0.18s var(--ease);
  }

  .site-footer__social-link:hover {
    color: var(--gold);
    border-color: var(--gold);
    transform: translateY(-2px);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 var(--space-1);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .site-footer__col a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--gold);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-dim);
    text-decoration: none;
  }

  .site-footer__top:hover {
    color: var(--gold);
  }
</style>
